<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/fragment_feed">

    <action
        android:id="@+id/action_global_logout"
        app:destination="@id/fragment_auth"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/fragment_auth"
        android:name="com.example.piattoproject.ui.auth.AuthFragment"
        android:label="Login">
        <action
            android:id="@+id/action_auth_to_feed"
            app:destination="@id/fragment_feed"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/fragment_feed"
        android:name="com.example.piattoproject.ui.post.FeedFragment"
        android:label="Feed">
        <action
            android:id="@+id/action_feed_to_addPost"
            app:destination="@id/fragment_add_post" />
        <action
            android:id="@+id/action_feed_to_post_details"
            app:destination="@id/fragment_post_details" />
    </fragment>

    <fragment
        android:id="@+id/fragment_add_post"
        android:name="com.example.piattoproject.ui.post.AddPostFragment"
        android:label="Create Post">
        <argument
            android:name="postId"
            android:defaultValue="@null"
            app:nullable="true"
            app:argType="string" />
        <argument
            android:name="isEditMode"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/fragment_map"
        android:name="com.example.piattoproject.ui.map.MapFragment"
        android:label="Map">
        <action
            android:id="@+id/action_map_to_post_details"
            app:destination="@id/fragment_post_details" />
    </fragment>

    <fragment
        android:id="@+id/fragment_profile"
        android:name="com.example.piattoproject.ui.profile.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profile_to_post_details"
            app:destination="@id/fragment_post_details" />
        <action
            android:id="@+id/action_profile_to_addPost"
            app:destination="@id/fragment_add_post" />
    </fragment>

    <fragment
        android:id="@+id/fragment_external_recipes"
        android:name="com.example.piattoproject.ui.externalrecipes.ExternalRecipesFragment"
        android:label="Recipes" />

    <fragment
        android:id="@+id/fragment_post_details"
        android:name="com.example.piattoproject.ui.postdetails.PostDetailsFragment"
        android:label="Post Details">
        <argument
            android:name="postId"
            app:argType="string" />
        <action
            android:id="@+id/action_post_details_to_add_post"
            app:destination="@id/fragment_add_post" />
    </fragment>

</navigation>
